          "hold_position"
        ],
        "proposed_events": [
          "SP.HEALTH.MEDICAL_CHECK"
        ]
      },
      "signature": {
        "opening": "acknowledge",
        "closing": "promise",
        "metaphor": null
      }
    },
    {
      "id": "ko.meeting.family.family.001",
      "responds_to": [
        "request_private_meeting"
      ],
      "target": [
        "family",
        "partner"
      ],
      "visibility": [
        "private"
      ],
      "persona": "family_parent",
      "domain": "SP.PRIVATE",
      "thread_type": "private_life",
      "emotion_range": [
        -1.0,
        0.8
      ],
      "variants": [
        {
          "weight": 3,
          "text": "할 얘기가 있다고? 무슨 일이야. 아니다, 전화로 하지 말고 와서 해. 밥 먹으면서. 언제 올 수 있어?"
        },
        {
          "weight": 2,
          "text": "그래, 만나자. 네가 먼저 보자고 하는 건 처음이네. 무슨 얘기든 괜찮아. 우리는 다 들을 준비가 돼 있어."
        }
      ],
      "effects": {
